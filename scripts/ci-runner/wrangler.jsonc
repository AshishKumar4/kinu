// kinu-ci-runner: the CI tier for any commit, on Cloudflare Containers (worker.ts). Deploy with
// `bun scripts/ci-runner-deploy.ts`; run with `bun scripts/ci-remote.ts <commit|worktree>`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kinu-ci-runner",
  "account_id": "f44999d1ddda7012e9a87729eba250f1",
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Both on the `durable_object` policy, as the devbox's boxes (DEVBOX-DECISIONS D50): no image, instance type or
  // cap here. Each start names what it starts from (`cloudflare/debian-trixie`, D72, or an environment snapshot) and
  // its size, and running instances count against the account's own limits.
  "containers": [
    { "class_name": "CiShard", "scheduling_policy": "durable_object" },
    { "class_name": "CiPreparer", "scheduling_policy": "durable_object" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CI_RUN", "class_name": "CiRun" },
      { "name": "CI_SHARD", "class_name": "CiShard" },
      { "name": "CI_ENVIRONMENTS", "class_name": "CiEnvironments" },
      { "name": "CI_PREPARER", "class_name": "CiPreparer" },
      { "name": "CI_TIMINGS", "class_name": "CiTimings" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CiRun", "CiShard", "CiEnvironments", "CiPreparer", "CiTimings"] }
  ],
  // Packs, plans, part verdicts and logs. A 7-day lifecycle rule on the bucket (scripts/ci-runner-deploy.ts) expires
  // them; the timing history and the environments live in their objects.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "kinu-ci-artifacts" }]
}
