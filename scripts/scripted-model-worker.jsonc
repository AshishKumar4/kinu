// The deployed tiers' scripted model (scripts/scripted-model-worker.ts), published by scripts/deploy.sh before the
// post-deploy wave. A Custom Domain, not a route, because the product's Worker calls it: a same-account Worker is
// fetchable at a Custom Domain only.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kinu-scripted-model",
  "account_id": "f44999d1ddda7012e9a87729eba250f1",
  "main": "scripted-model-worker.ts",
  "compatibility_date": "2025-12-01",
  "workers_dev": false,
  "routes": [{ "pattern": "scripted-model.kinu.run", "custom_domain": true }],
  "observability": { "logs": { "enabled": true } }
}
