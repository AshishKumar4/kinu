{
  "name": "kinu",
  "private": true,
  "description": "Self-evolving agent with MCTS parallel exploration, mutable scaffolding, and durable skill evolution",
  "license": "MIT",
  "keywords": [
    "agent",
    "mcts",
    "self-evolving",
    "cloudflare",
    "durable-objects"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun scripts/ladder.ts --install-hooks",
    "test": "bun test packages/agent-utils/ && bun test packages/core/ && bun test packages/compaction/",
    "test:workerd": "vitest run --root packages/cf-backend tests/workerd/",
    "check": "bun run lint && tsc --noEmit -p packages/agent-utils && tsc --noEmit -p packages/core && tsc --noEmit -p packages/compaction && tsc --noEmit -p packages/cf-backend && tsc --noEmit -p packages/cf-backend/tests/workerd && tsc --noEmit -p packages/cli-backend && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/test-utils && tsc --noEmit -p tests && tsc --noEmit -p scripts/tsconfig.scripts.json && node --check packages/pc-agent/src/index.js",
    "test:anti-slop": "tsc --noEmit -p tools/oxlint/anti-slop && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/rules.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/gate.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/drift.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/no-swallow.gate.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/no-wait-until.gate.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/no-ambient-git.gate.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/no-copy-rpc-stub.gate.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/no-untyped-console.gate.test.ts && node --no-warnings --experimental-strip-types tools/oxlint/anti-slop/import-extension.gate.test.ts",
    "lint": "bun run test:anti-slop && oxlint",
    "deploy": "bash scripts/deploy.sh production",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "dev": "bun run --cwd packages/cf-backend start",
    "cli": "bun run packages/cli/bin/cli.ts",
    "docs:cli": "bun run scripts/gen-cli-docs.ts",
    "layergate": "bun run scripts/layergate.ts",
    "layergate:lock": "bun run scripts/layergate.ts --lock",
    "gate:dead-code": "bun scripts/dead-code.ts",
    "gate:duplication": "bun scripts/ast-duplication.ts",
    "gate:wired": "bun scripts/wired.ts",
    "gate:reachability": "bun scripts/reachability.ts",
    "gate:set-equality": "bun scripts/gate-set-equality.ts",
    "gate:do-init": "bun scripts/do-init-gate.ts",
    "gate:egress-interception": "bun scripts/egress-interception.ts",
    "gate:platform": "bun scripts/platform-catalog.ts",
    "gate:computed-style": "bun scripts/computed-style.ts",
    "gate:capability-parity": "bun scripts/capability-parity.ts",
    "gate:policy-drift": "bun scripts/policy-drift.ts",
    "gate:silent-drop": "bun scripts/silent-drop.ts",
    "gate:skip-ratchet": "bun scripts/skip-ratchet.ts",
    "gate:typecheck-coverage": "bun scripts/typecheck-coverage.ts",
    "test:mutation": "bun test packages/core/tests/mutation-*.test.ts",
    "sweep:mutation": "bun scripts/mutation-sweep.ts",
    "test:eval": "bash scripts/eval-tier.sh",
    "ladder": "bun scripts/ladder.ts",
    "smoke:workspace": "bun run --cwd packages/cf-backend smoke:workspace",
    "verify:lean": "bash scripts/verify-lean.sh",
    "bench": "bun scripts/bench.ts",
    "gate:install-scripts": "bun scripts/install-scripts-gate.ts",
    "gate:dependency-advisories": "bun scripts/dependency-advisory-gate.ts",
    "gate:patch-parity": "bun scripts/patch-parity.ts",
    "gate:bench-corpus": "bun scripts/bench-corpus-gate.ts",
    "gate:scratch-ownership": "bun scripts/scratch-ownership.ts",
    "gate:literature-citations": "bun scripts/literature-citations.ts",
    "gate:doc-claims": "bun scripts/doc-claims.ts",
    "gate:commit-message": "bun scripts/commit-hygiene.ts",
    "gate:agents-fields": "bun scripts/agents-fields.ts",
    "gate:infra": "bun scripts/infra-verify.ts",
    "infra:provision": "bun scripts/infra-provision.ts",
    "infra:teardown": "bun scripts/infra-teardown.ts",
    "evals:full": "bash scripts/eval-tier.sh"
  },
  "knip": {
    "ignoreExportsUsedInFile": true,
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.ts!",
          "tools/oxlint/anti-slop/index.ts!"
        ],
        "project": [
          "scripts/**/*.ts!",
          "tools/**/*.ts!",
          "tests/**/*.ts"
        ]
      },
      "packages/cf-backend": {
        "entry": [
          "src/index.ts!",
          "src/gallery.tsx!",
          "src/gallery-agent-stub.ts!",
          "tests/**/*.test.ts"
        ]
      },
      "packages/cli-backend": {
        "entry": [
          "src/index.ts!",
          "src/branch-worker.ts!"
        ]
      }
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.80",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "ai": "^6.0.182",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "valibot": "^1.4.1",
    "workers-ai-provider": "^3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.9.1",
    "knip": "6.32.2",
    "oxc-parser": "0.143.0",
    "oxlint": "1.78.0",
    "puppeteer": "^24.41.0",
    "puppeteer-core": "^24.41.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "vitest-evals": "0.16.1",
    "wrangler": "^4.125.0"
  },
  "patchedDependencies": {
    "@plannotator/ui@0.30.0": "patches/@plannotator%2Fui@0.30.0.patch"
  },
  "overrides": {
    "fast-uri": "^3.1.3"
  }
}
