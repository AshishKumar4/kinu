{
  "name": "proteus",
  "version": "0.1.0",
  "private": true,
  "description": "Self-evolving agent with MCTS parallel exploration, mutable scaffolding, and durable skill evolution",
  "license": "MIT",
  "keywords": ["agent", "mcts", "self-evolving", "cloudflare", "durable-objects"],
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test --cwd packages/core",
    "check": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/cf-backend && tsc --noEmit -p packages/cli-backend && tsc --noEmit -p packages/cli",
    "dev": "cd packages/cf-backend && vite dev",
    "cli": "bun run packages/cli/bin/cli.ts",
    "verify:lean": "bash scripts/verify-lean.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.80",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "ai": "^6.0.182",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "typescript": "5.8.3",
    "valibot": "^1.4.1",
    "workers-ai-provider": "^3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.9.1",
    "puppeteer": "^24.41.0",
    "puppeteer-core": "^24.41.0",
    "wrangler": "^4.95.0"
  }
}
