*.db-wal
.lake/
.DS_Store

# Local AI-agent transcripts and handoff worktrees
.claude/
transcript*.json
*.transcript.json

# Environment files (may contain secrets)
.env
.env.local
.env.*.local
.dev.vars

# Reference clones (symlinked to parent repo's external/) — not part of the project
/external
/external/

# Python bytecode (bench/clbench is the only Python in the repo)
__pycache__/
*.py[cod]

# Compiled test artifacts (sources are .ts)
packages/core/tests/helpers.js
packages/core/tests/helpers.js.map
packages/core/tests/helpers.d.ts
packages/core/tests/helpers.d.ts.map

# Internal working notes: dated audits, program ledgers, design studies.
# Useful locally, not part of the published project.
/*-2[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md

# Mined Claude Code transcript corpora (`kinu label mine`). These describe
# the owner's private sessions and must never be committed; the default output
# lives outside any repository, and these patterns cover a run pointed at one.
# `packages/cli/tests/cc-corpus.test.ts` asserts both.
.cc-corpus/
CC-CORPUS-*.md

# External benchmark corpora (downloaded via harbor, not our source). Each
# carries a corpus.json manifest recording which release it is — see
# bench/harbor/corpus.py. 2.1 is the corpus of record; 2.0 is kept so results
# measured on it stay interpretable.
/deep-swe/
/terminal-bench-2.0/
/terminal-bench-2.1/

# Throwaway output of the bench/harbor bun --compile step
/.harbor-build-*/

# Preserved harbor job artifacts (raw trial evidence, not source)
/bench-artifacts/

# Cloudflare-internal research never belongs in a public repo. Nimbus kept its
# dossiers under this path, compiled from internal source, and only their
# citations escaped — into a shipped production constant.
/docs/research/

# Raw owner/session transcripts are private harness memory, never repository source.
# Requirements may cite local turn numbers, but the transcript itself stays under
# ~/.claude/projects/.../memory/requirements/.
/docs/requirements/OWNER-MESSAGES-VERBATIM.md

# UI verification screenshots — proof-of-work, regenerated on demand, never source.
/.ui-proof/

# Harness defect guard: a literal `local:` directory appears when a `local://` URI
# is resolved as a relative path. Never source; content lives in the run artifact.
/local:/

# vitest-evals tool-replay recordings. The eval tier sets
# VITEST_EVALS_REPLAY_MODE=off, but `resolveReplayMode()` defaults to "auto" —
# which RECORDS when no recording exists — so one tool declaring replay is enough
# to create this. A recording serialises tool `input` and `output` VERBATIM, and
# for an agent harness the inputs are where an `Authorization: Bearer` lives; a
# synthetic token was measured surviving into it intact. Ignored so an accident
# can never become a tracked file. Sanitising is per-tool and opt-in, so this
# stays ignored even after a `sanitize` hook exists.
/.vitest-evals/

# Scratch for tests/evals-artifact-contract.test.ts. It must live inside the repo
# so the child vitest can resolve `vitest/config` by walking up to node_modules —
# a /tmp directory emits no report at all. Removed in afterAll; ignored so a
# crashed run cannot leave a tracked file.
/.eval-artifact-contract-*/

# Scratch benchmark output from corpus generation — never committed. Swept into
# a commit once by a `git add -A` in a worktree; the real artifacts live under
# bench-artifacts/ and tests/bench/ with their own retention.
/*_benchmark.jsonl

# Behaviour-eval task output. The corpus tasks (`ws-inventory`, `ws-find-todo`,
# `ws-recover-cmd`) tell the agent to write these; the harness runs in a temp dir,
# so a root-level copy is an escaped run, never a fixture.
/report.txt
/todos.txt

# The nine internal design records the 2026-08-18 history sweep removed from
# every commit: specification drafts, spike write-ups, research notes, the
# requirements transcripts and the captured axis-study runs. They described the
# project to itself and were never meant to be published, and the sweep rewrote
# 1,898 commits down to 844 to take them out of the history as well as the tree.
# Listed here because that is expensive to do and cheap to undo: a stray write, a
# `git add -A`, or a merge from a branch that predates the sweep would put one
# back as a tracked file and nothing else would notice. Prose references to their
# SECTION numbers survive in source on purpose — re-homing those is a separate
# decision and needs a document, not a re-add.
#
# `/docs/requirements/` widens the narrower entry above, which stays because it
# states a different reason: that transcript is private harness memory whatever
# the sweep did with the rest of the directory.
/docs/EXPLORATION-SPEC.md
/docs/NODE-ISOLATION.md
/docs/CRAFTED-TOOL-LOADING.md
/docs/NIMBUS-SPIKE-MEASUREMENTS-2026-08-04.md
/docs/RESEARCH_NOTES.md
/docs/requirements/
/scripts/axis-ergonomics/REPORT.md
/scripts/axis-ergonomics/PREREGISTRATION.md
/scripts/axis-ergonomics/runs/

# Proof captures: screenshots and walk artifacts, regenerated by the scripts
/scripts/artifacts/
