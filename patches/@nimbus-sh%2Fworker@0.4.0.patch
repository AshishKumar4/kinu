+++ b/dist/session/supervisor-rpc.d.ts
@@ -4,10 +4,24 @@
  * Exported from index.ts. Facets receive `env.SUPERVISOR` service binding
  * pointing to this class via ctx.exports loopback binding.
  *
- * Props: { doId: string, pid: number, writerId: string }
- *   doId — the supervisor DO's durable object ID (for routing)
- *   pid  — the process ID (for stdout/stderr routing)
+ * Every method below reaches the host that owns the workspace through ONE
+ * dispatch method, named by the fabric composition and defaulting to
+ * `supervisorOp`. The namespace it resolves that host in is composed too, so
+ * a Durable Object of any class can host a workspace: it mounts one method
+ * and forwards it to `workspace.supervisorOp(op)`. Before that seam existed
+ * both halves were hard-wired to `NimbusSession` — the namespace binding and
+ * the sixty methods called on it — and an embedder's facet could reach
+ * nothing.
+ *
+ * Props: { doId: string, pid: number, writerId: string, mutationOwner?: string }
+ *   doId — the id of the object hosting the workspace (for routing)
+ *   pid  — the process ID (credentials every filesystem operation)
  *   writerId — the active append-writer incarnation for this process
+ *   mutationOwner — the exclusive-mutation lease the streaming write rides
+ *
+ * The identity half of that bag rides the dispatch envelope rather than the
+ * argument list, so a facet can neither choose nor drop the credential its
+ * writes land under.
  *
  * Methods callable by facets via RPC:
  *   readFile(path) → string | null
@@ -54,15 +68,47 @@ export type SupervisorCacheStatEvent = {
 };
 export declare class SupervisorRPC extends WorkerEntrypoint {
     /**
-     * The supervisor DO stub for RPC routing, found from the doId in ctx.props.
+     * The host that owns this workspace, reached through the ONE method it
+     * mounts.
+     *
+     * Both halves of this used to be hard-wired to `NimbusSession`: the
+     * namespace (`env.NIMBUS_SESSION`) and the sixty methods called on what it
+     * returned. An embedder binds neither — it runs its own class, in its own
+     * namespace — so a facet holding a perfectly good supervisor binding could
+     * reach nothing. The composition names the namespace and the method
+     * (`composeFabric({ hostNamespace, hostDispatchMethod })`, defaulting to
+     * the hosted product's own), and everything below goes through
+     * {@link _op}.
      *
      * Minted per call, because that is the only lifetime an instance of this
      * class has: workerd constructs a NEW WorkerEntrypoint for every RPC call,
      * not one per facet invocation, so a field cached here is written and
-     * discarded by the same call and never read by another (measured: two calls
-     * on one stub produced instances #3 and #4, each having served one call).
+     * discarded by the same call and never read by another (measured: two
+     * calls on one stub produced instances #3 and #4, each having served one
+     * call).
+     */
+    private _dispatch;
+    /**
+     * Perform one operation on the host, under this binding's own identity.
+     *
+     * The pid, the append-writer incarnation and the mutation-lease owner come
+     * from `ctx.props` — the trusted half of the binding — and never from the
+     * facet, so a process can neither choose nor drop the credential its
+     * writes land under.
+     */
+    private _op;
+    /**
+     * The same, credentialed to the invoking process. Every filesystem
+     * operation goes through this, so the pid a facet's write lands under is
+     * stamped in exactly one place.
+     */
+    private _fsOp;
+    /**
+     * The lenient pid the output operations carry. Process IO is attributed
+     * best-effort — a facet reporting its own exit must not fail because its
+     * props are half-gone — which is the 0 the pre-dispatch code passed.
      */
-    private _getStub;
+    private _reportingPid;
     private _call;
     private _pid;
     private _writerId;
