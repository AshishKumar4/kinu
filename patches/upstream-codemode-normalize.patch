diff --git a/packages/codemode/scripts/test-normalize-portable.mjs b/packages/codemode/scripts/test-normalize-portable.mjs
new file mode 100644
--- /dev/null
+++ b/packages/codemode/scripts/test-normalize-portable.mjs
@@ -0,0 +1,14 @@
+import assert from "node:assert/strict";
+import { normalizeCode } from "@cloudflare/codemode/normalize";
+
+const execute = (code, probe) =>
+  new Function("probe", `return (\n${normalizeCode(code)}\n)()`)(probe);
+assert.equal(await execute("const n = await Promise.resolve(1);\n(n +\n41)\n// result"), 42);
+assert.equal(await execute("await Promise.resolve(); return 42"), 42);
+assert.deepEqual(await execute("({ answer: 42 })"), { answer: 42 });
+assert.equal(await execute("async () => 42 // result"), 42);
+let calls = 0;
+await assert.rejects(execute('await probe(); throw new Error("boom")', () => ++calls), /boom/);
+assert.equal(calls, 1);
+assert.throws(() => execute("return import.meta"), SyntaxError);
+console.log("portable normalize export: behavior verified without Workers builtins");
