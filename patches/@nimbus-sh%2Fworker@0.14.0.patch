+    // Kinu patch (NIMBUS-ASKS #39): the chunks one relay call carried, written
+    // in order and so pending in order: taken out in one pass, not one each.
+    ackedRun(chunks) {
+      if (!run || chunks.length === 0) return;
+      const pending = run.pending;
+      for (let i = 0; i < pending.length; i++) {
+        if (pending[i] === chunks[0]) {
+          let k = 0;
+          while (k < chunks.length && i + k < pending.length && pending[i + k] === chunks[k]) k++;
+          for (let j = i; j < pending.length - k; j++) pending[j] = pending[j + k];
+          pending.length = pending.length - k;
+          for (let r = k; r < chunks.length; r++) this.acked(chunks[r]);
+          return;
+        }
+      }
+      for (let r = 0; r < chunks.length; r++) this.acked(chunks[r]);
+    },
     // A synchronous read of stdin that wants bytes and finds \\\`available\\\`
     // (\\\`ended\\\`: no more will come): how many it returns, or -1 when it has
     // to wait for more.
