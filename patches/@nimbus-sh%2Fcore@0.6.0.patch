+/**
+ * supervisor-op.ts — the one call a facet's host answers.
+ *
+ * A facet runs in its own isolate and reaches the object that owns the
+ * filesystem through a supervisor entrypoint, which runs in a THIRD isolate.
+ * That entrypoint has to get from "a facet called `SUPERVISOR.stat(path)`" to
+ * "the host that owns this workspace performed a stat". Before this seam it
+ * did that by resolving one hard-wired Durable Object namespace and calling
+ * one of sixty methods on the class it found there — so hosting a workspace
+ * meant BEING that class.
+ *
+ * Now the host mounts one method. It takes an envelope naming the operation
+ * and forwards it to the handler a workspace already carries:
+ *
+ *   class MyActor extends DurableObject {
+ *     async supervisorOp(op) {
+ *       return (await this.workspace()).supervisorOp(op);
+ *     }
+ *   }
+ *
+ * The operation names are the supervisor entrypoint's own method names, so a
+ * facet's call site is unchanged and the wire is greppable from both ends.
+ *
+ * The table IS the interface: an operation this handler does not name does
+ * not exist, and asking for one is an error rather than a reflective call
+ * into whatever the host happens to expose. A host with capabilities of its
+ * own — the hosted session has process brokering, port routing and an R2
+ * cache — passes them as `extend`, which is how `NimbusSession` reaches its
+ * own surface through this same one method.
+ */
+
+import type { SqliteVFS } from '../vfs/sqlite-vfs.js';
+import { CRED_SESSION_USER, type VfsCred } from '../runtime/os-contracts.js';
+import { SqliteRuntimeFsBridge } from '../runtime/sqlite-runtime-fs-bridge.js';
+import { getSymlinkRegistry } from '../vfs/symlink-registry.js';
+import type { SessionProcessSupervisor } from '../runtime/session-process-supervisor.js';
+
+/**
+ * What crosses the supervisor→host boundary.
+ *
+ * `pid`, `writerId` and `mutationOwner` are stamped by the supervisor
+ * entrypoint from the props its binding was minted with, never by the facet:
+ * a process can neither choose nor drop the identity its writes are
+ * credentialed under. They ride the envelope rather than `args` because they
+ * are authority, not arguments — a host reading this envelope can tell what
+ * the caller IS from what it ASKED FOR.
+ *
+ * `stream` carries a `ReadableStream` for the streaming write path. It is a
+ * top-level field because a byte stream crossing an RPC boundary has its
+ * underlying source transferred, and keeping it out of the serialized
+ * argument list makes that transfer the obvious thing it is.
+ */
+export interface SupervisorOpEnvelope {
+  /** The operation name — the supervisor entrypoint's own method name. */
+  readonly op: string;
+  /** Positional arguments, in the order the operation names them. */
+  readonly args?: readonly unknown[];
+  /** The invoking process. Absent means a host call with no process behind it. */
+  readonly pid?: number;
+  /** The active append-writer incarnation, for the append operations. */
+  readonly writerId?: string;
+  /** The exclusive-mutation lease owner, for the streaming write path. */
+  readonly mutationOwner?: string;
+  /** The byte stream, for `writeBatchStream`. */
+  readonly stream?: ReadableStream<Uint8Array>;
+}
+
+/** One named operation. */
+export type SupervisorOpHandler = (envelope: SupervisorOpEnvelope) => unknown;
+
+/** What a workspace needs to answer the operations it owns. */
+export interface SupervisorOpDeps {
+  /** The filesystem the workspace owns. */
+  readonly vfs: SqliteVFS;
+  /**
+   * The process table the pids are allocated from. A pid resolves to the
+   * credential its writes are performed under; absent, every operation acts
+   * as the unprivileged session user, which is the identity `.exec` runs as.
+   */
+  readonly processes?: SessionProcessSupervisor;
+  /**
+   * Where a facet's stdout and stderr go. Absent, a facet's progress output
+   * is discarded — a host with no terminal has nowhere to put it, and
+   * inventing one would put a facet's bytes somewhere the host never asked
+   * for.
+   */
+  readonly output?: (stream: 'stdout' | 'stderr', pid: number, data: string) => void;
+  /**
+   * Operations the host serves itself. A name the library owns cannot be
+   * shadowed, so a host cannot silently redefine what a filesystem write
+   * means.
+   */
+  readonly extend?: Readonly<Record<string, SupervisorOpHandler>>;
+}
+
+/** Read a string argument, or refuse. The caller is another isolate. */
+function stringArg(envelope: SupervisorOpEnvelope, index: number): string {
+  const value = (envelope.args ?? [])[index];
+  if (typeof value !== 'string') {
+    throw new Error(`supervisor op ${envelope.op}: argument ${index} must be a string`);
+  }
+  return value;
+}
+
+/** Read a finite number argument, or refuse. */
+function numberArg(envelope: SupervisorOpEnvelope, index: number): number {
+  const value = (envelope.args ?? [])[index];
+  if (typeof value !== 'number' || !Number.isFinite(value)) {
+    throw new Error(`supervisor op ${envelope.op}: argument ${index} must be a number`);
+  }
+  return value;
+}
+
+/** Read a bytes-or-text argument, which is what the write operations take. */
+function contentArg(envelope: SupervisorOpEnvelope, index: number): string | Uint8Array {
+  const value = (envelope.args ?? [])[index];
+  if (typeof value === 'string' || value instanceof Uint8Array) return value;
+  if (value instanceof ArrayBuffer) return new Uint8Array(value);
+  throw new Error(`supervisor op ${envelope.op}: argument ${index} must be bytes or text`);
+}
+
+/**
+ * The credential an operation acts under.
+ *
+ * A pid always wins, because the supervisor stamps it from its own props. An
+ * absent pid is a host call — the SDK over a binding, a static asset read —
+ * and those act as the session user. A supplied-but-invalid pid is refused
+ * rather than downgraded: a write credentialed to nothing is worse than a
+ * refused write.
+ */
+function credFor(deps: SupervisorOpDeps, pid: number | undefined): VfsCred {
+  if (pid === undefined) return CRED_SESSION_USER;
+  if (!Number.isInteger(pid) || pid <= 0) {
+    throw new Error('supervisor op: filesystem operation requires a valid process pid');
+  }
+  if (!deps.processes) return CRED_SESSION_USER;
+  return deps.processes.cred(pid);
+}
+
+/** Pid-less host callers share one bridge; pids can never collide with it. */
+const HOST_CALLER_KEY = 0;
+
+/**
+ * Build the handler a host mounts.
+ *
+ * The bridge is cached per caller rather than per call: it holds the symlink
+ * resolution and open-handle state a facet's repeated reads walk, and
+ * rebuilding it per operation would discard that between two reads of one
+ * file.
+ */
+export function createSupervisorOpHandler(
+  deps: SupervisorOpDeps,
+): (envelope: SupervisorOpEnvelope) => Promise<unknown> {
+  const bridges = new Map<number, SqliteRuntimeFsBridge>();
+
+  const bridgeFor = (pid: number | undefined): SqliteRuntimeFsBridge => {
+    const key = pid ?? HOST_CALLER_KEY;
+    const credentialed = deps.vfs.as(credFor(deps, pid));
+    const held = bridges.get(key);
+    if (held) {
+      held.updateCredential(credentialed);
+      return held;
+    }
+    const built = new SqliteRuntimeFsBridge(credentialed, deps.vfs);
+    bridges.set(key, built);
+    return built;
+  };
+
+  const ops: Readonly<Record<string, SupervisorOpHandler>> = {
+    // ── Filesystem reads ────────────────────────────────────────────────
+    readFile: async (e) => {
+      const bytes = await bridgeFor(e.pid).readFile(stringArg(e, 0));
+      return bytes === null ? null : new TextDecoder().decode(bytes);
+    },
+    readFileBytes: (e) => bridgeFor(e.pid).readFile(stringArg(e, 0)),
+    stat: (e) => bridgeFor(e.pid).stat(stringArg(e, 0)),
+    lstat: (e) => bridgeFor(e.pid).stat(stringArg(e, 0), { followSymlinks: false }),
+    exists: async (e) => (await bridgeFor(e.pid).stat(stringArg(e, 0))) !== null,
+    readdir: (e) => bridgeFor(e.pid).readdir(stringArg(e, 0)),
+    readlink: (e) => bridgeFor(e.pid).readlink(stringArg(e, 0)),
+    fsReadRange: (e) =>
+      bridgeFor(e.pid).readRange(stringArg(e, 0), numberArg(e, 1), numberArg(e, 2)),
+    fsReadRangeUncached: (e) =>
+      bridgeFor(e.pid).readRange(stringArg(e, 0), numberArg(e, 1), numberArg(e, 2), {
+        cached: false,
+      }),
+    fsRevision: (e) => bridgeFor(e.pid).revision(
+      (e.args ?? [])[0] === undefined ? undefined : stringArg(e, 0),
+    ),
+    hasLegacySymlinkUnder: (e) => getSymlinkRegistry(deps.vfs).hasAtOrBelow(stringArg(e, 0)),
+
+    // ── Filesystem writes ───────────────────────────────────────────────
+    writeFile: (e) => bridgeFor(e.pid).writeFile(stringArg(e, 0), contentArg(e, 1)),
+    mkdir: (e) => bridgeFor(e.pid).mkdir(stringArg(e, 0), { recursive: true }),
+    rmdir: (e) => bridgeFor(e.pid).rmdir(stringArg(e, 0)),
+    unlink: (e) => bridgeFor(e.pid).unlink(stringArg(e, 0)),
+    rename: (e) => bridgeFor(e.pid).rename(stringArg(e, 0), stringArg(e, 1)),
+    symlink: (e) => bridgeFor(e.pid).symlink(stringArg(e, 0), stringArg(e, 1)),
+    chmod: (e) => bridgeFor(e.pid).chmod(stringArg(e, 0), numberArg(e, 1)),
+    utimes: (e) => bridgeFor(e.pid).utimes(stringArg(e, 0), numberArg(e, 1), numberArg(e, 2)),
+    fsTruncate: (e) => bridgeFor(e.pid).truncate(stringArg(e, 0), numberArg(e, 1)),
+    /**
+     * The streaming bulk write. The lease owner rides the envelope, so the
+     * VFS enforces the same exclusive-mutation scope it enforces for the
+     * hosted session: a clone's committed prefix stays inside the root its
+     * caller holds a lease on.
+     */
+    writeBatchStream: (e) => {
+      if (!e.stream) throw new Error('supervisor op writeBatchStream: no stream');
+      return deps.vfs.as(credFor(deps, e.pid)).writeStream(e.stream, {
+        mutationOwner: e.mutationOwner,
+      });
+    },
+
+    // ── Process output ──────────────────────────────────────────────────
+    stdout: (e) => { deps.output?.('stdout', e.pid ?? 0, stringArg(e, 0)); },
+    stderr: (e) => { deps.output?.('stderr', e.pid ?? 0, stringArg(e, 0)); },
+  };
+
+  const extend = deps.extend ?? {};
+  return async (envelope: SupervisorOpEnvelope): Promise<unknown> => {
+    if (!envelope || typeof envelope.op !== 'string') {
+      throw new Error('supervisor op: envelope names no operation');
+    }
+    // A host that serves an operation itself is authoritative for it: the
+    // hosted session's own `writeBatchStream` carries W7 drain accounting and
+    // its `stdout` carries prior-generation attribution, and neither is
+    // something the library can perform on its behalf. The table below is
+    // what a host that serves nothing gets, which is the whole filesystem.
+    const handler = extend[envelope.op] ?? ops[envelope.op];
+    if (!handler) {
+      throw new Error(`supervisor op: '${envelope.op}' is not served by this host`);
+    }
+    return handler(envelope);
+  };
+}
