+        // ── Process output ──────────────────────────────────────────────────
+        stdout: (e) => { deps.output?.('stdout', e.pid ?? 0, stringArg(e, 0)); },
+        stderr: (e) => { deps.output?.('stderr', e.pid ?? 0, stringArg(e, 0)); },
