+          className="rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground disabled:opacity-40"
+          onClick={submit}
+          disabled={!text.trim()}
+        >
+          Save
+        </button>
+      </div>
+    </div>,
+    document.body,
+  );
