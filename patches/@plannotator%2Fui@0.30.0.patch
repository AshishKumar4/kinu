+        <span className="mr-auto text-[10px] text-muted-foreground">Ctrl/⌘ + Enter</span>
+        <button
+          type="button"
+          className="rounded-md px-3 py-1.5 text-xs text-muted-foreground hover:bg-muted hover:text-foreground"
