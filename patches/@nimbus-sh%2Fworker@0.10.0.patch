+import { RpcTarget } from 'cloudflare:workers';
+import type { VfsCred } from '@nimbus-sh/core/runtime/os-contracts.js';
+import * as operations from '../session/programmatic.js';
+export interface HostedSessionScope {
+    /** The only named shell a command may run in; every command must name it (`sandbox(id, { shellId })`). */
+    readonly shellId?: string;
+    /** The identity every command and file operation runs as. */
+    readonly cred?: VfsCred;
+}
+type RunCodeOptions = operations.ProgrammaticExecOptions & {
+    language?: 'javascript' | 'typescript' | 'python' | 'ruby' | 'shell';
+    install?: 'never' | 'ifMissing';
+};
+type Visibility = { visibility?: 'scoped' | 'public'; name?: string };
+export declare class HostedSession extends RpcTarget {
+    private readonly owner;
+    private readonly scope;
+    constructor(owner: operations.ProgrammaticHost, scope: HostedSessionScope);
+    private cred;
+    private exec;
+    _rpcReady(options?: operations.ProgrammaticReadyOptions): ReturnType<typeof operations.ensureProgrammaticReady>;
+    _rpcExec(command: string, options?: operations.ProgrammaticExecOptions): ReturnType<typeof operations.rpcExec>;
+    _rpcStartProcess(command: string, options?: operations.ProgrammaticExecOptions): ReturnType<typeof operations.rpcStartProcess>;
+    _rpcRunCode(code: string, options?: RunCodeOptions): ReturnType<typeof operations.rpcRunCode>;
+    _rpcReadFile(path: string, _pid?: undefined, cred?: VfsCred): Promise<string | null>;
+    _rpcReadFileBytes(path: string, _pid?: undefined, cred?: VfsCred): Promise<Uint8Array | null>;
+    _rpcWriteFile(path: string, content: string | Uint8Array, _pid?: undefined, cred?: VfsCred): Promise<void>;
+    _rpcStat(path: string, _pid?: undefined, cred?: VfsCred): Promise<any>;
+    _rpcLstat(path: string, _pid?: undefined, cred?: VfsCred): Promise<any>;
+    _rpcReaddir(path: string, _pid?: undefined, cred?: VfsCred): Promise<{ name: string; type: string }[]>;
+    _rpcRename(from: string, to: string, _pid?: undefined, cred?: VfsCred): Promise<void>;
+    _rpcChmod(path: string, mode: number, _pid?: undefined, cred?: VfsCred): Promise<void>;
+    _rpcFsReadRange(path: string, offset: number, length: number, _pid?: undefined, cred?: VfsCred): Promise<Uint8Array | null>;
+    _rpcExists(path: string, _pid?: undefined, cred?: VfsCred): Promise<boolean>;
+    _rpcMkdir(path: string, _pid?: undefined, cred?: VfsCred): Promise<void>;
+    _rpcDeleteFile(path: string, options?: { recursive?: boolean }, cred?: VfsCred): Promise<void>;
+    _rpcInstallRuntime(spec: string, options?: { force?: boolean }): ReturnType<typeof operations.rpcInstallRuntime>;
+    _rpcEnsureRuntimes(specs: string[], options?: { force?: boolean }): ReturnType<typeof operations.rpcEnsureRuntimes>;
+    _rpcListRuntimes(): ReturnType<typeof operations.rpcListRuntimes>;
+    _rpcListProcesses(): ReturnType<typeof operations.rpcListProcesses>;
+    _rpcKillProcess(pid: number): ReturnType<typeof operations.rpcKillProcess>;
+    _rpcWriteProcessInput(pid: number, data: string): ReturnType<typeof operations.rpcWriteProcessInput>;
+    _rpcEndProcessInput(pid: number): ReturnType<typeof operations.rpcEndProcessInput>;
+    _rpcResizeProcess(pid: number, size: { columns: number; rows: number }): ReturnType<typeof operations.rpcResizeProcess>;
+    _rpcSignalProcess(pid: number, signal: string): ReturnType<typeof operations.rpcSignalProcess>;
+    _rpcProcessLogs(pid: number, options?: { cursor?: number; lines?: number; bytes?: number }): ReturnType<typeof operations.rpcProcessLogs>;
+    _rpcListPorts(): ReturnType<typeof operations.rpcListPorts>;
+    _rpcExposePort(port: number, options?: Visibility): ReturnType<typeof operations.rpcExposePort>;
+    _rpcExposeApp(target: operations.AppTarget, options?: Visibility): ReturnType<typeof operations.rpcExposeApp>;
+    _rpcListApps(): ReturnType<typeof operations.rpcListApps>;
+    _rpcRotateLink(target: operations.AppTarget): ReturnType<typeof operations.rpcRotateLink>;
+    _rpcRemoveApp(target: operations.AppTarget): ReturnType<typeof operations.rpcRemoveApp>;
+    _rpcEnsureDurableApp(input: { owner: string; preferredPort?: number; visibility?: 'scoped' | 'public'; name?: string }): ReturnType<typeof operations.rpcEnsureDurableApp>;
+    _rpcRemoveDurableApp(owner: string): ReturnType<typeof operations.rpcRemoveDurableApp>;
+    _rpcUnexposePort(port: number): ReturnType<typeof operations.rpcUnexposePort>;
+    _rpcDestroy(): Promise<never>;
+}
+export {};
