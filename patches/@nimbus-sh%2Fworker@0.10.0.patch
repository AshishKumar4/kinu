@@ -0,0 +1,76 @@
+/**
+ * The SDK's session surface, served by a hosted runtime (Nimbus work/session-surface,
+ * carried by Kinu until it publishes). An RpcTarget, so an embedder can hand it to code in
+ * another isolate. A scoped session is a capability: its commands run only in its named
+ * shell and it acts only as its identity; a caller naming another is refused.
+ */
+import { RpcTarget } from 'cloudflare:workers';
+import * as rpc from '../session/rpc.js';
+import * as operations from '../session/programmatic.js';
+function sameCred(a, b) {
+    return a.uid === b.uid && a.gid === b.gid && a.umask === b.umask
+        && a.groups.length === b.groups.length && a.groups.every((group, index) => group === b.groups[index]);
+}
+export class HostedSession extends RpcTarget {
+    owner;
+    scope;
+    constructor(owner, scope) {
+        super();
+        this.owner = owner;
+        this.scope = scope;
+    }
+    cred(asked) {
+        const bound = this.scope.cred;
+        if (bound === undefined || asked === undefined)
+            return bound ?? asked;
+        if (!sameCred(bound, asked))
+            throw new Error('EPERM: this session is bound to another identity');
+        return bound;
+    }
+    exec(options) {
+        const { shellId } = this.scope;
+        if (shellId !== undefined && options?.shellId !== shellId) {
+            throw new Error(`EPERM: this session runs commands only in shell '${shellId}'; name it`);
+        }
+        const cred = this.cred(options?.cred);
+        return { ...options, ...(cred === undefined ? {} : { cred }) };
+    }
+    _rpcReady(options) { return operations.ensureProgrammaticReady(this.owner, options); }
+    _rpcExec(command, options) { return operations.rpcExec(this.owner, command, this.exec(options)); }
+    _rpcStartProcess(command, options) { return operations.rpcStartProcess(this.owner, command, this.exec(options)); }
+    _rpcRunCode(code, options) { return operations.rpcRunCode(this.owner, code, this.exec(options)); }
+    _rpcReadFile(path, _pid, cred) { return rpc._rpcReadFile(this.owner, path, undefined, this.cred(cred)); }
+    _rpcReadFileBytes(path, _pid, cred) { return rpc._rpcReadFileBytes(this.owner, path, undefined, this.cred(cred)); }
+    async _rpcWriteFile(path, content, _pid, cred) { await rpc._rpcWriteFile(this.owner, path, content, undefined, this.cred(cred)); }
+    _rpcStat(path, _pid, cred) { return rpc._rpcStat(this.owner, path, undefined, this.cred(cred)); }
+    _rpcLstat(path, _pid, cred) { return rpc._rpcLstat(this.owner, path, undefined, this.cred(cred)); }
+    _rpcReaddir(path, _pid, cred) { return rpc._rpcReaddir(this.owner, path, undefined, this.cred(cred)); }
+    _rpcRename(from, to, _pid, cred) { return rpc._rpcRename(this.owner, from, to, undefined, this.cred(cred)); }
+    _rpcChmod(path, mode, _pid, cred) { return rpc._rpcChmod(this.owner, path, mode, undefined, this.cred(cred)); }
+    _rpcFsReadRange(path, offset, length, _pid, cred) { return rpc._rpcFsReadRange(this.owner, path, offset, length, undefined, this.cred(cred)); }
+    _rpcExists(path, _pid, cred) { return rpc._rpcExists(this.owner, path, undefined, this.cred(cred)); }
+    _rpcMkdir(path, _pid, cred) { return rpc._rpcMkdir(this.owner, path, undefined, this.cred(cred)); }
+    _rpcDeleteFile(path, options, cred) { return operations.rpcDeleteFile(this.owner, path, options, this.cred(cred)); }
+    _rpcInstallRuntime(spec, options) { return operations.rpcInstallRuntime(this.owner, spec, options); }
+    _rpcEnsureRuntimes(specs, options) { return operations.rpcEnsureRuntimes(this.owner, specs, options); }
+    _rpcListRuntimes() { return operations.rpcListRuntimes(this.owner); }
+    _rpcListProcesses() { return operations.rpcListProcesses(this.owner); }
+    _rpcKillProcess(pid) { return operations.rpcKillProcess(this.owner, pid); }
+    _rpcWriteProcessInput(pid, data) { return operations.rpcWriteProcessInput(this.owner, pid, data); }
+    _rpcEndProcessInput(pid) { return operations.rpcEndProcessInput(this.owner, pid); }
+    _rpcResizeProcess(pid, size) { return operations.rpcResizeProcess(this.owner, pid, size); }
+    _rpcSignalProcess(pid, signal) { return operations.rpcSignalProcess(this.owner, pid, signal); }
+    _rpcProcessLogs(pid, options) { return operations.rpcProcessLogs(this.owner, pid, options); }
+    _rpcListPorts() { return operations.rpcListPorts(this.owner); }
+    _rpcExposePort(port, options) { return operations.rpcExposePort(this.owner, port, options); }
+    _rpcExposeApp(target, options) { return operations.rpcExposeApp(this.owner, target, options); }
+    _rpcListApps() { return operations.rpcListApps(this.owner); }
+    _rpcRotateLink(target) { return operations.rpcRotateLink(this.owner, target); }
+    _rpcRemoveApp(target) { return operations.rpcRemoveApp(this.owner, target); }
+    _rpcEnsureDurableApp(input) { return operations.rpcEnsureDurableApp(this.owner, input); }
+    _rpcRemoveDurableApp(owner) { return operations.rpcRemoveDurableApp(this.owner, owner); }
+    _rpcUnexposePort(port) { return operations.rpcUnexposePort(this.owner, port); }
+    async _rpcDestroy() {
+        throw new Error('EPERM: a hosted session cannot destroy the workspace; its embedder closes the runtime');
+    }
+}
