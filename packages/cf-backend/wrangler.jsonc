{
  "name": "proteus",
  "account_id": "f44999d1ddda7012e9a87729eba250f1",
  "workers_dev": true,
  "main": "src/server.ts",
  "compatibility_date": "2025-12-01",
  // `experimental` is a dev-only umbrella flag that the deploy API rejects
  // (code 10021). If a specific experimental feature is needed, enable it
  // by its real flag name (e.g. `streaming_subrequests`).
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  // Main site served by the custom domain. Sandbox and Nimbus previews use
  // authenticated path-style URLs on this same domain, so Proteus does not
  // need per-agent subdomains or wildcard TLS/DNS.
  // custom_domain: true tells wrangler to auto-create the DNS record on
  // deploy. Without it, the `pattern + zone_id` form requires a pre-existing
  // proxied DNS record on the zone (manual setup via the dashboard).
  "routes": [
    { "pattern": "proteus.ashishkumarsingh.com", "custom_domain": true }
  ],
  // Worker runs first for every non-hashed-asset request. That lets
  // proxyToSandbox intercept preview-URL hosts before the SPA fallback
  // serves index.html. Static assets under /assets/* (hashed bundles)
  // bypass the Worker for speed.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "OrchestratorAgent", "name": "OrchestratorAgent" },
      { "class_name": "ExplorationAgent", "name": "ExplorationAgent" },
      // Per-user DO: profile + agent registry + credentials + defaults.
      // Keyed by stable Proteus userId assigned by AUTH_DB.
      { "class_name": "UserDO", "name": "UserDO" },
      // Nimbus SDK session DO. Used directly through Nimbus.fromEnv() — no
      // endpoint/token secrets are required for Proteus's built-in Nimbus
      // executor.
      { "class_name": "NimbusSession", "name": "NIMBUS_SESSION" },
      // Sandbox — @cloudflare/sandbox DO + Container. One container per agent
      // (keyed by agent name). Binding name MUST be "Sandbox" — the SDK's
      // proxyToSandbox hardcodes `env.Sandbox` lookup (see
      // @cloudflare/sandbox/dist/file-stream-*.js:3448).
      { "class_name": "ProteusSandbox", "name": "Sandbox" }
      //
      // SSH/laptop (user's local machine via WebSocket tunnel):
      //   No binding needed — users run a local daemon. The executor becomes
      //   available when a tunnel WebSocket attaches at runtime.
    ]
  },
  "containers": [
    {
      "class_name": "ProteusSandbox",
      "image": "docker.io/cloudflare/sandbox:0.11.0",
      "max_instances": 10,
      "instance_type": {
        "vcpu": 2,
        "memory_mib": 6144,
        "disk_mb": 8000
      }
    }
  ],
  "migrations": [
    // Production's DO classes were registered together under v1 before launch.
    // Keep this sequence stable; named environments below declare their own
    // deployed class-registration history.
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrchestratorAgent", "ExplorationAgent", "ProteusSandbox", "UserDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["NimbusSession"]
    }
  ],
  // AI_GATEWAY_AUTH is a Wrangler secret — set via:
  //   echo "<your-token>" | npx wrangler secret put AI_GATEWAY_AUTH
  // For local dev, add to .dev.vars:
  //   AI_GATEWAY_AUTH=Bearer <your-token>
  // PREVIEW_HOSTNAME is the public host the UI/agents use when building
  // preview URLs. We serve previews via a path prefix (`/_preview/...`)
  // on the main custom domain — no wildcard DNS required. See
  // packages/cf-backend/src/preview-proxy.ts for the routing logic.
  //
  // (The @cloudflare/sandbox SDK's built-in preview URL scheme requires a
  // wildcard DNS record + non-workers.dev hostname, neither of which is
  // available here; we bypass it with our own token-gated proxy.)
  "vars": {
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f44999d1ddda7012e9a87729eba250f1/proteus-ai-gateway/workers-ai/v1",
    "PREVIEW_HOSTNAME": "proteus.ashishkumarsingh.com",
    "CLI_PUBLIC_ORIGIN": "https://proteus.ashishkumarsingh.com",
    "CLI_APPROVAL_ORIGIN": "https://proteus.ashishkumarsingh.com",
    "CLOUDFLARE_OAUTH_CLIENT_ID": "457ce8fea9fb4e89d4a6df3a71cdf875",
    "CLOUDFLARE_OAUTH_SCOPES": "user-details.read account-settings.read ai.write",
    "CLOUDFLARE_OAUTH_TOKEN_AUTH_METHOD": "client_secret_basic",
    // OAuth provider visibility is config-driven. A provider appears on
    // /login only when both its CLIENT_ID var and CLIENT_SECRET secret exist.
    // Set ids as vars and secrets via `wrangler secret put`:
    //   GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
    //   GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET
    //   CLOUDFLARE_OAUTH_CLIENT_ID / CLOUDFLARE_OAUTH_CLIENT_SECRET
    // ── Nimbus — built-in lightweight sandbox ────────────────────────
    // Uses the NIMBUS_SESSION Durable Object binding above through the
    // official @nimbus-sh/sdk. No endpoint/token secrets are required.
  },
  // Workers AI binding — used for platform-side embeddings. Chat model calls
  // use the logged-in user's Cloudflare OAuth credential so Workers AI usage
  // bills to that user's Cloudflare account/quota.
  "ai": { "binding": "AI" },
  // R2 bucket for sandbox /workspace backups (squashfs archives). The SDK's
  // localBucket backup mode moves bytes straight through this binding — no
  // presigned R2 credentials needed. Bucket: `wrangler r2 bucket create
  // proteus-backups` (already created). Set an R2 lifecycle rule on the
  // `backups/` prefix to GC expired archives.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "proteus-backups" }
  ],
  // D1 auth/session store. Browser auth reads use D1 Sessions API so Cloudflare
  // can route read-only verification queries to read replicas when replication
  // is enabled on this database.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "proteus-auth",
      "database_id": "87ca0567-04e5-4c66-b0da-86442eb77bf6",
      "migrations_dir": "migrations/auth"
    }
  ],
  // ── Staging environment (headless testing) ──────────────────────
  // A second deployment on *.workers.dev for testing think/tools directly
  // without production OAuth secrets in the way. Differences from prod: a distinct
  // worker name (`proteus-staging`) — which gives it ISOLATED Durable Object
  // namespaces, so staging never touches prod data — no custom-domain route,
  // and `DEV_USER_EMAIL` set, so authenticateRequest() (auth/session.ts)
  // synthesizes a fixed dev identity and the worker is reachable headlessly.
  // Fully specified because wrangler does not inherit
  // bindings/vars into named environments. Deploy: `wrangler deploy --env staging`.
  "env": {
    "staging": {
      "name": "proteus-staging",
      "workers_dev": true,
      "routes": [],
      "main": "src/server.ts",
      "compatibility_date": "2025-12-01",
      "compatibility_flags": ["nodejs_compat"],
      "worker_loaders": [{ "binding": "LOADER" }],
      "assets": {
        "directory": "dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/assets/*"]
      },
      "durable_objects": {
        "bindings": [
          { "class_name": "OrchestratorAgent", "name": "OrchestratorAgent" },
          { "class_name": "ExplorationAgent", "name": "ExplorationAgent" },
          { "class_name": "UserDO", "name": "UserDO" },
          { "class_name": "NimbusSession", "name": "NIMBUS_SESSION" },
          { "class_name": "ProteusSandbox", "name": "Sandbox" }
        ]
      },
      "containers": [
        {
          "class_name": "ProteusSandbox",
          "image": "docker.io/cloudflare/sandbox:0.11.0",
          "max_instances": 5,
          "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 8000 }
        }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["OrchestratorAgent", "ExplorationAgent"] },
        { "tag": "v2", "new_sqlite_classes": ["ProteusSandbox"] },
        { "tag": "v3", "new_sqlite_classes": ["UserDO"] },
        { "tag": "v4", "new_sqlite_classes": ["NimbusSession"] }
      ],
      "ai": { "binding": "AI" },
      "r2_buckets": [
        { "binding": "BACKUP_BUCKET", "bucket_name": "proteus-backups" }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "proteus-auth-staging",
          "database_id": "f81423fd-ece5-41ea-a217-b9540ebea502",
          "migrations_dir": "migrations/auth"
        }
      ],
      "vars": {
        "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f44999d1ddda7012e9a87729eba250f1/proteus-ai-gateway/workers-ai/v1",
        "PREVIEW_HOSTNAME": "proteus-staging.ashishkmr472.workers.dev",
        "CLI_PUBLIC_ORIGIN": "https://proteus-staging.ashishkmr472.workers.dev",
        "CLI_APPROVAL_ORIGIN": "https://proteus-staging.ashishkmr472.workers.dev",
        "DEV_USER_EMAIL": "staging-tester@proteus.dev"
      }
    }
  }
  // ── OPTIONAL: Vectorize binding for semantic memory ─────────────
  //
  // First create the index:
  //   wrangler vectorize create proteus-memory \
  //     --dimensions=384 --metric=cosine
  //
  // Then add the binding:
  //   ,"vectorize": [
  //     { "binding": "MEMORY_VECTORS", "index_name": "proteus-memory" }
  //   ]
  //
  // Once present, runtime.ts auto-detects it and constructs
  // CloudflareVectorStore; search_memory + searchMemoryHybrid return
  // RRF-merged FTS5 + Vectorize hits. Without it, agent transparently
  // falls back to FTS5-only.
}
