{
  "name": "proteus",
  "account_id": "f44999d1ddda7012e9a87729eba250f1",
  "workers_dev": true,
  "main": "src/server.ts",
  "compatibility_date": "2025-12-01",
  // `experimental` is a dev-only umbrella flag that the deploy API rejects
  // (code 10021). If a specific experimental feature is needed, enable it
  // by its real flag name (e.g. `streaming_subrequests`).
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  // Main site served by the custom domain. Sandbox preview URLs use the
  // workers.dev subdomain (see PREVIEW_HOSTNAME) because workers.dev
  // auto-resolves *.<worker>.<sub>.workers.dev without needing zone DNS.
  // custom_domain: true tells wrangler to auto-create the DNS record on
  // deploy. Without it, the `pattern + zone_id` form requires a pre-existing
  // proxied DNS record on the zone (manual setup via the dashboard).
  "routes": [
    { "pattern": "proteus.ashishkumarsingh.com", "custom_domain": true }
  ],
  // Worker runs first for every non-hashed-asset request. That lets
  // proxyToSandbox intercept preview-URL hosts before the SPA fallback
  // serves index.html. Static assets under /assets/* (hashed bundles)
  // bypass the Worker for speed.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "OrchestratorAgent", "name": "OrchestratorAgent" },
      { "class_name": "ExplorationAgent", "name": "ExplorationAgent" },
      // Sandbox — @cloudflare/sandbox DO + Container. One container per agent
      // (keyed by agent name). Binding name MUST be "Sandbox" — the SDK's
      // proxyToSandbox hardcodes `env.Sandbox` lookup (see
      // @cloudflare/sandbox/dist/file-stream-*.js:3448).
      { "class_name": "ProteusSandbox", "name": "Sandbox" }
      //
      // SSH/laptop (user's local machine via WebSocket tunnel):
      //   No binding needed — users run a local daemon. The executor becomes
      //   available when a tunnel WebSocket attaches at runtime.
    ]
  },
  "containers": [
    {
      "class_name": "ProteusSandbox",
      "image": "docker.io/cloudflare/sandbox:0.8.11",
      "max_instances": 10,
      "instance_type": {
        "vcpu": 2,
        "memory_mib": 6144,
        "disk_mb": 8000
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrchestratorAgent", "ExplorationAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProteusSandbox"]
    },
    // v3/v4 reserved (HeadAgent + ReviewAgent — both removed in cleanup;
    // head mode now lives in ExplorationAgent's existing SQLite class,
    // background review folded back into EvolutionEngine's onTurnCompleteAsync).
  ],
  // AI_GATEWAY_AUTH is a Wrangler secret — set via:
  //   echo "<your-token>" | npx wrangler secret put AI_GATEWAY_AUTH
  // For local dev, add to .dev.vars:
  //   AI_GATEWAY_AUTH=Bearer <your-token>
  // PREVIEW_HOSTNAME is the public host the UI/agents use when building
  // preview URLs. We serve previews via a path prefix (`/_preview/...`)
  // on the main custom domain — no wildcard DNS required. See
  // packages/cf-backend/src/preview-proxy.ts for the routing logic.
  //
  // (The @cloudflare/sandbox SDK's built-in preview URL scheme requires a
  // wildcard DNS record + non-workers.dev hostname, neither of which is
  // available here; we bypass it with our own token-gated proxy.)
  "vars": {
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f44999d1ddda7012e9a87729eba250f1/proteus-ai-gateway/workers-ai/v1",
    "PREVIEW_HOSTNAME": "proteus.ashishkumarsingh.com"
  }
  // ── v2 OPTIONAL bindings — uncomment after running the corresponding setup ──
  //
  // 1) Workers AI for memory embeddings (no setup beyond enabling Workers AI):
  //
  //   "ai": { "binding": "AI" }
  //
  // 2) Vectorize index for semantic memory recall. First create the index:
  //
  //   wrangler vectorize create proteus-memory \
  //     --dimensions=384 --metric=cosine
  //
  // Then add the binding:
  //
  //   "vectorize": [
  //     { "binding": "MEMORY_VECTORS", "index_name": "proteus-memory" }
  //   ]
  //
  // Once both are set, runtime.ts auto-detects them and constructs
  // CloudflareVectorStore; the new searchMemoryHybrid @callable + MCP
  // tool returns RRF-merged FTS5 + Vectorize hits. Without these, the
  // agent transparently falls back to FTS5-only memory.
}
