{
  "name": "kinu",
  "account_id": "f44999d1ddda7012e9a87729eba250f1",
  // No workers.dev origin. `kinu.run` is the ONLY hostname this deployment
  // answers on, which is what lets transport security key on one canonical
  // origin instead of a set, and leaves no unbranded second origin serving
  // the same app under a different cookie site.
  "workers_dev": false,
  "main": "src/server.ts",
  "compatibility_date": "2025-12-01",
  // `experimental` is a dev-only umbrella flag that the deploy API rejects
  // (code 10021). If a specific experimental feature is needed, enable it
  // by its real flag name (e.g. `streaming_subrequests`).
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler uploads the Worker's source maps with the version, and Cloudflare
  // remaps every uncaught exception's stack against them before it reaches
  // Workers Logs or a tail. Without this, a production stack trace names the one
  // minified bundle with line numbers that belong to nothing a person can open —
  // which is what the 2026-07-13 abrupt-stop incident's root error looked like
  // once it was persisted.
  //
  // It costs nothing against the 10 MB script budget: source maps travel as
  // separate `application/source-map` parts and are NOT in the module list
  // wrangler measures (`printBundleSize` receives `modules` and the entry, never
  // `sourceMaps`; their own limit is 15 MB gzipped). The maps that get uploaded
  // are the ones Vite emits — the deploy goes through the plugin's generated
  // config, which sets `no_bundle`, so wrangler bundles nothing of its own and
  // scans each module's `sourceMappingURL` instead. vite.config.ts turns
  // `build.sourcemap` on for every worker environment and leaves the CLIENT
  // build without maps, because a client map in `dist/client` would be published
  // on the public origin.
  "upload_source_maps": true,
  // Persisted Workers Logs — without this, provider/turn errors are gone the
  // moment they scroll out of a live `wrangler tail` (made the 2026-07-13
  // abrupt-stop incident's root error unrecoverable). head_sampling_rate is
  // spelled out at its default (1 = every request/invocation logged, no
  // sampling) rather than left implicit — this DO runs hours-long background
  // jobs (MCTS forks, evict-recovery redrives) where a sampled-out activation
  // is exactly the one an operator needed to see (2026-08-12 observability
  // audit). 7-day retention on the paid tier (Cloudflare's Workers Logs
  // limit, not ours) — `wrangler tail` is live-only and sees nothing older.
  //
  // TRACES ARE A SEPARATE SWITCH and the bare `enabled: true` above governs LOGS
  // ONLY. Without the `traces` block every custom span this Worker opens is
  // created, reports `isTraced` false, and is never recorded — measured under
  // real workerd: no collector attached gives {"outer":false,"inner":false},
  // one attached gives {"outer":true,"inner":true}. That is the whole tracing
  // investment silently dead with the Worker still answering 200, so
  // `scripts/tracing-gate.ts` fails when the tracer factory is used in src and
  // this key is absent from ANY deployable environment. It is repeated in
  // `env.staging` because wrangler does NOT inherit `observability` into named
  // environments — a preview with traces off reports success while measuring a
  // different system.
  //
  // There is deliberately NO `tail_consumers` here. A tail consumer is not
  // needed for the platform to ingest traces, and a Worker that names ITSELF as
  // its own tail consumer and touches a binding inside the handler is a load
  // generator: measured at 51 self-invocations within 300 ms of ONE request,
  // still climbing at 3 s, bounded only by a breaker inside the probe. Keeping
  // the key absent makes that unreachable rather than merely discouraged.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  // Main site served by the custom domain. Workspace and Sandbox previews get an
  // isolated capability hostname each under PREVIEW_HOST_SUFFIX below.
  // custom_domain: true tells wrangler to auto-create the DNS record on
  // deploy. Without it, the `pattern + zone_name` form requires a pre-existing
  // proxied DNS record on the zone (manual setup via the dashboard).
  //
  // ONE app origin. Verified against the API on 2026-08-20 before wiring
  // anything: zone `6c181c0cb19bef416fcc7f1fef7f6993`, active since 2026-08-18,
  // on THIS Worker's account (f44999d1ddda7012e9a87729eba250f1) — a custom
  // domain cannot cross accounts, so that check is the precondition, not a
  // formality. The zone held zero DNS records, so `custom_domain: true` creates
  // the apex record rather than competing with one.
  //
  // The preview wildcard is `*.kinu.run`, ONE label deep, which is exactly what
  // this zone's Universal SSL certificate covers alongside the apex. A deeper
  // suffix (`*.preview.kinu.run`) would need Advanced Certificate Manager, and
  // HSTS `includeSubDomains` from the apex would then pin preview hostnames
  // that have no certificate at all. One label is the shape that is free AND
  // safe, so the app host is also the preview suffix.
  //
  // `staging.kinu.run` is claimed by env.staging as a ROUTE rather than a custom
  // domain, precisely because it sits under this wildcard: route matching picks
  // the most specific pattern, so an exact hostname beats `*.kinu.run/*`, while
  // custom-domain-versus-route precedence is documented only for the SAME
  // hostname and would be an assumption here. The cost is a proxied DNS record
  // for that name created by hand — see docs/DEPLOYMENT.md.
  "routes": [
    { "pattern": "kinu.run", "custom_domain": true },
    { "pattern": "*.kinu.run/*", "zone_name": "kinu.run" }
  ],
  // The Worker runs first for every request. Asset routing is path-only, so an
  // `/assets/*` bypass would also intercept preview apps' own asset paths
  // before the preview hostname can be recognized. App assets still flow
  // through serveApp → this binding after the host-aware route table.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "OrchestratorAgent", "name": "OrchestratorAgent" },
      // Per-user DO: profile + agent registry + credentials + defaults.
      // Keyed by the stable Kinu userId derived from the verified email.
      { "class_name": "UserDO", "name": "UserDO" },
      // Synthetic monitoring — one instance ("site"), driven by the cron
      // trigger below. Holds open incidents (so an outage alerts once, not
      // every tick) and the alert outbox.
      { "class_name": "MonitorDO", "name": "MonitorDO" },
      // Nimbus SDK session DO. Used directly through Nimbus.fromEnv() — no
      // endpoint/token secrets are required for Kinu's built-in Nimbus
      // executor.
      { "class_name": "NimbusSession", "name": "NIMBUS_SESSION" },
      // Sandbox — @cloudflare/sandbox DO + Container. One container per agent
      // (keyed by agent name). Binding name MUST be "Sandbox" — the SDK's
      // proxyToSandbox hardcodes `env.Sandbox` lookup (see
      // @cloudflare/sandbox/dist/file-stream-*.js:3448).
      { "class_name": "KinuSandbox", "name": "Sandbox" },
      // Control plane — one instance ("site"), the singleton the admin surface
      // reads. It is a singleton because its questions are fleet-wide: "who are
      // the users", "which workspaces exist", "what did an admin do" have no
      // per-user shard that could answer them, and a fan-out over every UserDO
      // is a subrequest count that grows with the account. It holds an INDEX and
      // an AUDIT LOG and no business logic: every action it exposes proxies an
      // existing @callable on the DO that already owns that state.
      { "class_name": "ControlPlaneDO", "name": "ControlPlaneDO" }
      //
      // SSH/laptop (user's local machine via WebSocket tunnel):
      //   No binding needed — users run a local daemon. The executor becomes
      //   available when a tunnel WebSocket attaches at runtime.
    ]
  },
  // PINNED BY DIGEST, not by tag. A tag is a mutable pointer, and this is the one
  // file where a mutable pointer decides which bytes run inside a container
  // holding somebody's workspace: `docker.io/cloudflare/sandbox:0.12.8` can be
  // re-pushed by anyone who can push that repository, and the next container
  // start would pick the new image up with nothing here changed and nothing to
  // read afterwards that says which image ran.
  //
  // The digest is `cloudflare/sandbox:0.12.8` as the registry resolved it on
  // 2026-08-27, from the manifest endpoint itself:
  //   curl -sI -H "Authorization: Bearer <docker.io pull token>" \
  //     -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
  //     https://registry-1.docker.io/v2/cloudflare/sandbox/manifests/0.12.8
  //   docker-content-digest: sha256:822501de5f0c52a012c125c4e5e4c0080421a8e93ca4ce0ba3d247148021989f
  //
  // 0.12.8 must stay equal to the `@cloudflare/sandbox` version in package.json:
  // the SDK asks the container for its own SANDBOX_VERSION on every start and
  // logs a mismatch (Sandbox.checkVersionCompatibility). The intended
  // version→digest pair is declared once, in `scripts/release-config.test.ts`,
  // which holds it against package.json, holds BOTH environments to the same
  // reference and refuses a tagged one. A version bump edits that pair, this
  // block and env.staging's — and nothing else.
  "containers": [
    {
      "class_name": "KinuSandbox",
      "image": "docker.io/cloudflare/sandbox@sha256:822501de5f0c52a012c125c4e5e4c0080421a8e93ca4ce0ba3d247148021989f",
      "max_instances": 10,
      "instance_type": {
        "vcpu": 2,
        "memory_mib": 6144,
        "disk_mb": 8000
      }
    }
  ],
  // Append-only from the first deploy onwards. `v1` registered the six classes
  // this Worker shipped with and is never edited again — a later SQLite class
  // gets its own tag, which is what `v2` is. `ExplorationAgent` is in v1
  // without a binding above because it is reached as a facet of
  // OrchestratorAgent rather than by name.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrchestratorAgent", "ExplorationAgent", "KinuSandbox", "UserDO",
        "NimbusSession", "MonitorDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ControlPlaneDO"]
    }
  ],
  // Synthetic monitoring. Every 15 minutes the worker probes its own public
  // surface and emails OPS_ALERT_EMAIL when something breaks — the checks
  // scripts/deploy.sh runs at deploy time, kept running afterwards. No
  // third-party monitoring service is involved.
  "triggers": { "crons": ["*/15 * * * *"] },
  // CREDENTIAL_ENCRYPTION_KEY is a REQUIRED Wrangler secret — the root secret
  // for the user plane. It encrypts every provider credential a user connects
  // (user/credential-envelope.ts) and derives the owner capability every
  // privileged UserDO call presents (user/workspace-capability.ts), so a
  // deployment without it cannot serve a signed-in user at all. Set via:
  //   openssl rand -base64 32 | npx wrangler secret put CREDENTIAL_ENCRYPTION_KEY
  // Rotation uses CREDENTIAL_ENCRYPTION_KEY_PREVIOUS — see docs/DEPLOYMENT.md.
  //
  // WEBHOOK_ROUTE_SECRET is a REQUIRED Wrangler secret wherever webhook ingress
  // is offered. It signs the route capability every public delivery URL carries
  // (events/webhook-route.ts), which is what decides that a stranger's POST may
  // address one workspace and no other. Without it, creating a webhook answers
  // 503 and every delivery URL answers 404 without waking a workspace. Set via:
  //   openssl rand -base64 32 | npx wrangler secret put WEBHOOK_ROUTE_SECRET
  // It is separate from the root secret because the two rotate on different
  // clocks: these URLs live in other people's systems, and rotating this one
  // revokes all of them at once — see docs/DEPLOYMENT.md.
  //
  // PREVIEW_HOST_SUFFIX is the zone Workspace and Sandbox previews are served
  // under. Each exposed port gets its own capability hostname: the Sandbox SDK
  // mints its host shape and Kinu binds Nimbus ports to their session
  // capabilities. Every host under the suffix except this Worker's own serves
  // previews and NOTHING else — no SPA, no login — so no Kinu session ever
  // exists on them.
  //
  // A hostname per port isolates origin-scoped storage and same-origin fetch
  // while letting the preview keep normal browser origin semantics. See
  // lib/preview-origin.ts.
  //
  // SECURITY PREREQUISITE: sibling origins are not sibling cookie sites unless
  // this suffix is itself on the Public Suffix List. `kinu.run` is not, so
  // JavaScript can still set a Domain cookie across previews. A PSL-backed
  // suffix is required before this can be claimed as hostile-preview cookie
  // isolation.
  //
  // Previews are ON, served under `kinu.run` via the proxied wildcard `*` record
  // on the zone plus the matching route above. `custom_domain: true` cannot
  // express a wildcard host, which is why the preview route uses the
  // `pattern + zone_name` form against a DNS record created by hand.
  //
  // The suffix IS the app host, one label above every preview hostname. That is
  // the only depth this zone's Universal SSL certificate covers, and HSTS is
  // sent with `includeSubDomains` from the apex — so a deeper suffix would pin
  // browsers to hostnames with no certificate. The bare zone wildcard is also
  // safe to claim here in a way it was not on a shared personal zone: kinu.run
  // carries this product and nothing else, so every subdomain SHOULD reach this
  // Worker, and anything that should not gets a more specific route, which is
  // exactly how env.staging takes `staging.kinu.run`.
  //
  // Setting this empty means previews are unavailable: exposePort tells the
  // agent so instead of handing back a URL that cannot resolve. It does NOT
  // disable either executor.
  "vars": {
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f44999d1ddda7012e9a87729eba250f1/kinu-ai-gateway/workers-ai/v1",
    // Container control plane. Both getSandbox call sites pass `transport: "rpc"`
    // explicitly and that is what actually switches an EXISTING sandbox — the SDK
    // persists transport in the sandbox object's storage and a stored value beats
    // this var on every cold start. The var covers the other direction: a future
    // getSandbox that omits the option would otherwise inherit the SDK's `http`
    // field default, which is the route-based compatibility client. Cloudflare
    // deprecated `http`/`websocket` on 2026-06-09 ("will not ship in future
    // Sandbox SDK majors") and 1.0 drops the knob entirely, so `rpc` is both the
    // measured-better and the only surviving path.
    "SANDBOX_TRANSPORT": "rpc",
    "PREVIEW_HOST_SUFFIX": "kinu.run",
    "CLI_PUBLIC_ORIGIN": "https://kinu.run",
    "CLI_APPROVAL_ORIGIN": "https://kinu.run",
    "CLOUDFLARE_OAUTH_CLIENT_ID": "edb106782fc08e60480306cf39411d90",
    // Scopes default to CLOUDFLARE_WORKERS_AI_SCOPES (lib/cloudflare-oauth.ts);
    // set CLOUDFLARE_OAUTH_SCOPES here only to override that one source.
    "CLOUDFLARE_OAUTH_TOKEN_AUTH_METHOD": "client_secret_basic",
    "CLOUDFLARE_AI_GATEWAY_ID": "default",
    // Mission Inbox mail domain: <agent-name>@EMAIL_DOMAIN. Takes effect only
    // after the one-time Email Routing / Email Sending setup in
    // docs/EMAIL-INGRESS.md is done for this domain.
    "EMAIL_DOMAIN": "kinu.run",
    // Where synthetic-monitoring alerts land. Same mail path as the Mission
    // Inbox, so it works exactly when outbound email does.
    "OPS_ALERT_EMAIL": "me@ashishkumarsingh.com",
    // Who may reach /control and /api/control/*. A comma-separated allowlist of
    // verified session emails, deliberately a var rather than a secret: an
    // allowlist that cannot be read is an allowlist nobody can audit, and the
    // addresses are not credentials. EMPTY MEANS NOBODY, and the admin plane
    // then answers 404 to every caller including this owner — which is the
    // right default for any deployment that has not decided its operators.
    "CONTROL_PLANE_ADMINS": "me@ashishkumarsingh.com",
    // Account the Analytics Engine SQL API is queried against. The same id as
    // `account_id` above; a plain var because it is in this file already, and
    // the Worker cannot read the deploy-time field. Its companion is the
    // ANALYTICS_SQL_API_TOKEN secret (Account Analytics: Read):
    //   npx wrangler secret put ANALYTICS_SQL_API_TOKEN
    // With either absent the control plane's metrics view reports itself
    // unconfigured; every other admin view is unaffected.
    "CLOUDFLARE_ACCOUNT_ID": "f44999d1ddda7012e9a87729eba250f1",
    // What this deployment appends to every Analytics Engine dataset NAME on the
    // READ path. Writes go through the bindings below, which already name the
    // right dataset per environment; the SQL API takes a name, and production's
    // is the unsuffixed one. `scripts/analytics-datasets.test.ts` holds this
    // equal to the `analytics_engine_datasets` block of the same environment,
    // which is what stops staging's panels answering with production's numbers.
    "ANALYTICS_DATASET_SUFFIX": "",
    // OAuth provider visibility is config-driven. A provider appears on
    // /login only when both its CLIENT_ID var and CLIENT_SECRET secret exist.
    // Set ids as vars and secrets via `wrangler secret put`:
    //   GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
    //   GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET
    //   CLOUDFLARE_OAUTH_CLIENT_ID / CLOUDFLARE_OAUTH_CLIENT_SECRET
    // ── Nimbus — built-in lightweight sandbox ────────────────────────
    // Uses the NIMBUS_SESSION Durable Object binding above through the
    // official @nimbus-sh/sdk. No endpoint/token secrets are required.
  },
  // ── Mission Inbox (Email Routing + Email Sending) ────────────────
  // Inbound: an Email Routing catch-all rule on EMAIL_DOMAIN delivers to this
  // Worker's email() handler; the local part is the agent name. Outbound:
  // thread replies + owner notifications through this binding. ONE-TIME
  // OWNER SETUP required (domain onboarding + routing rule) — see
  // docs/EMAIL-INGRESS.md. Until then the binding is inert: inbound mail
  // never arrives and outbound sends skip quietly.
  "send_email": [{ "name": "EMAIL" }],
  // Workers AI binding. Serves platform-side work billed to THIS account:
  // embeddings, HTML→markdown, and the `ai-gateway` provider's chat transport
  // (providers/gateway-binding-fetch.ts) — binding calls are pre-authenticated
  // in-account, which is why that provider needs no API token. A signed-in
  // user's own chat calls deliberately do NOT ride this binding: they carry that
  // user's Cloudflare OAuth credential so the usage bills to their account.
  "ai": { "binding": "AI" },
  // Analytics Engine — the fleet-level aggregate plane. Three datasets rather
  // than one because sampling is keyed on `index1`: a single dataset would let
  // a noisy turn stream sample away the admin audit markers, and three unrelated
  // row shapes would have to share twenty blob slots. Writes are unsampled
  // fire-and-forget from the Worker; reads go over the SQL API, which is why
  // CLOUDFLARE_ACCOUNT_ID + ANALYTICS_SQL_API_TOKEN exist. NOTHING user-authored
  // is written here — no prompt, no message, no free text, no email, no header:
  // the two identifiers that could carry user text (workspace name, admin
  // email) are digested before they are written.
  "analytics_engine_datasets": [
    { "binding": "AGENT_METRICS", "dataset": "kinu_agent_metrics" },
    { "binding": "FEEDBACK_MARKERS", "dataset": "kinu_feedback_markers" },
    { "binding": "CONTROL_PLANE_OPS", "dataset": "kinu_control_plane_ops" }
  ],
  // R2 bucket for sandbox /workspace snapshots (squashfs archives), written and
  // read by KinuSandbox. Bucket: `wrangler r2 bucket create kinu-backups`
  // (already created). Set an R2 lifecycle rule on the `backups/` prefix to GC
  // archives past their TTL — the SDK enforces TTL at restore time only and
  // never deletes anything itself.
  //
  // The devbox strategies stream bytes container → this object → R2 through
  // the bucket BINDING; no credential ever enters the container. The old
  // presigned-URL mode and its four env values (R2_ACCESS_KEY_ID and friends)
  // were retired when storage moved to @kinu.run/devbox: no product source
  // reads them, and the secret census now refuses stale entries.
  // NIMBUS_RUNTIME_CACHE is the artifact store a HOSTED workspace installs its
  // toolchain from: `catalog/v1.json`, `manifests/<name>-<version>.json` and
  // content-addressed blobs under `blobs/<name>-<version>/<file>`
  // (external/nimbus/packages/worker/src/runtime/runtime-catalog.ts:111-150).
  // Measured 2026-08-17: this bucket exists on this account and IS seeded —
  // clang, python, ruby, bash, cpython. Without the binding the Worker throws
  // `NIMBUS_RUNTIME_CACHE binding missing`, which is why a hosted `python3` was
  // 127 while the local CLI (which ships the runtimes as npm packages) worked.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "kinu-backups" },
    { "binding": "NIMBUS_RUNTIME_CACHE", "bucket_name": "nimbus-runtime-cache" },
    // In-product feedback screenshots. Bytes live here and NEVER in a Durable
    // Object row or an analytics blob: a PNG is megabytes, a DO row is read by
    // the admin list view, and an AE datapoint has a 16 KiB budget. The row in
    // ControlPlaneDO carries the object key only.
    //   wrangler r2 bucket create kinu-feedback
    { "binding": "FEEDBACK_BUCKET", "bucket_name": "kinu-feedback" }
  ],
  // Browser sessions, one-time OAuth state, and CLI browser-approval state.
  // All of it expires on its own clock, and all of it is read at the edge on
  // the request path, which is what KV is for. Nothing here is a source of
  // truth: an emptied namespace costs everyone a fresh sign-in and nothing else.
  "kv_namespaces": [
    { "binding": "AUTH_KV", "id": "4a677dd3488e4325917a2e4aefa9a6f8" }
  ],
  // Semantic memory: runtime.ts auto-detects MEMORY_VECTORS and builds the
  // CloudflareVectorStore so search_memory / searchMemoryHybrid return
  // RRF-merged FTS5 + Vectorize hits (384-dim to match the Workers AI embedder).
  "vectorize": [
    { "binding": "MEMORY_VECTORS", "index_name": "kinu-memory" }
  ],
  // ── Staging environment: where tests and evals run ──────────────
  //
  // Nothing that measures this system may point at production. A test run and
  // the owner working are otherwise the same event on the same account, and on
  // 2026-08-20 that was not hypothetical: production held 28 workspaces of
  // which 23 were test debris (22 `drill*` rows and one `settle-probe`), minted
  // by harnesses driving the owner's signed-in session. So this environment is
  // the eval plane, and `packages/test-utils/src/eval-identity.ts` refuses any
  // other target unless KINU_EVAL_ALLOW_PROD=1 names the exception.
  //
  // Three things make it that, and each is pinned by a test in
  // `packages/test-utils/tests/eval-identity.test.ts` so a rename here fails
  // there rather than silently pointing the evals at a Worker that is gone:
  //
  //   * A DISTINCT WORKER NAME (`kinu-staging`), which is what gives it its own
  //     Durable Object namespaces. Isolation is a consequence of the name, not
  //     of a setting, so the name is the load-bearing part.
  //   * ITS OWN STORES. Every stateful binding below differs from production's.
  //     A shared one is a test writing into real data by another route — see
  //     the R2 and Vectorize notes.
  //   * `DEV_USER_EMAIL` set to the eval service account, naming the ONE
  //     identity a caller may act as here without signing in. It names WHICH
  //     identity, never that anyone may have it: off localhost,
  //     `authenticateRequest()` (auth/session.ts) grants it only to a request
  //     presenting the `DEV_IDENTITY_SECRET` secret in `x-kinu-dev-identity`.
  //     Evals act as `eval-service` and never as a person, and a caller who
  //     merely reaches staging.kinu.run acts as nobody. Set the secret with
  //     `wrangler secret put DEV_IDENTITY_SECRET --env staging`; without it
  //     this deployment grants no synthetic identity at all. Production must
  //     leave both unset.
  //
  // Fully specified because wrangler inherits no bindings or vars into a named
  // environment. Deploy: `wrangler deploy --env staging`.
  //
  // `staging.kinu.run` is a ROUTE, not a custom domain, and `workers_dev` is off.
  // The route form is what makes precedence unambiguous against production's
  // `*.kinu.run/*` preview wildcard: the most specific pattern wins, and an
  // exact hostname is more specific than a wildcard. It needs a proxied DNS
  // record for that name, created by hand — `custom_domain: true` would create
  // the record for us but puts the two claims on different mechanisms whose
  // relative precedence Cloudflare documents only for identical hostnames.
  // workers.dev is off because a second origin on a worker that synthesizes an
  // identity from DEV_USER_EMAIL is an auth bypass reachable at a guessable
  // name — and with one origin the eval allowlist needs no workers.dev arm.
  "env": {
    "staging": {
      "name": "kinu-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.kinu.run/*", "zone_name": "kinu.run" }
      ],
      "main": "src/server.ts",
      "compatibility_date": "2025-12-01",
      "compatibility_flags": ["nodejs_compat"],
      // Spelled out here as well. `upload_source_maps` IS inheritable, unlike
      // `observability` below, but this environment states every deployable key
      // it depends on rather than reading the top of the file — and an
      // environment whose stack traces cannot be read is where an eval failure
      // becomes unexplainable.
      "upload_source_maps": true,
      // `traces` is a SEPARATE switch from `logs`, and wrangler does not inherit
      // `observability` into a named environment — see the header. A bare
      // `enabled: true` here governed logs only, so every span this Worker opened
      // in staging reported isTraced false and was never recorded.
      "observability": {
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 }
      },
      "worker_loaders": [{ "binding": "LOADER" }],
      "assets": {
        "directory": "dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          { "class_name": "OrchestratorAgent", "name": "OrchestratorAgent" },
          { "class_name": "UserDO", "name": "UserDO" },
          { "class_name": "MonitorDO", "name": "MonitorDO" },
          { "class_name": "NimbusSession", "name": "NIMBUS_SESSION" },
          { "class_name": "KinuSandbox", "name": "Sandbox" },
          { "class_name": "ControlPlaneDO", "name": "ControlPlaneDO" }
        ]
      },
      // The same digest production runs, for the same reason and under the same
      // gate — see the production `containers` block. An environment measuring
      // the product on a different image measures a different product.
      "containers": [
        {
          "class_name": "KinuSandbox",
          "image": "docker.io/cloudflare/sandbox@sha256:822501de5f0c52a012c125c4e5e4c0080421a8e93ca4ce0ba3d247148021989f",
          "max_instances": 5,
          "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 8000 }
        }
      ],
      // Append-only here too, and for the same reason: `v1` is the shipped set
      // and `v2` adds the control plane. The two environments stay one shape.
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "OrchestratorAgent", "ExplorationAgent", "KinuSandbox", "UserDO",
            "NimbusSession", "MonitorDO"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["ControlPlaneDO"]
        }
      ],
      // No cron trigger and no OPS_ALERT_EMAIL here: staging has no OAuth
      // providers and no mail route, so the probes would report a site that
      // is missing on purpose. The class is registered so the two environments
      // stay one shape.
      // Staging has the binding for parity but no EMAIL_DOMAIN — the Mission
      // Inbox stays off (no routing rule points here; outbound sends skip).
      "send_email": [{ "name": "EMAIL" }],
      "ai": { "binding": "AI" },
      // Staging's OWN datasets. Analytics Engine datasets are account-scoped, so
      // a shared name is an eval run writing into the numbers an operator reads —
      // the same class of leak as the R2 and Vectorize notes below.
      "analytics_engine_datasets": [
        { "binding": "AGENT_METRICS", "dataset": "kinu_agent_metrics_staging" },
        { "binding": "FEEDBACK_MARKERS", "dataset": "kinu_feedback_markers_staging" },
        { "binding": "CONTROL_PLANE_OPS", "dataset": "kinu_control_plane_ops_staging" }
      ],
      // BACKUP_BUCKET is staging's OWN bucket. It used to be production's
      // `kinu-backups`, which meant every /workspace snapshot an eval's
      // sandbox took was written into the bucket holding real users' archives —
      // the same class of leak as running the evals against the production
      // origin, by a route nobody was looking at.
      //
      // NIMBUS_RUNTIME_CACHE is deliberately still shared: a runtime artifact
      // is content-addressed and immutable, so there is nothing to keep apart,
      // and reading the same seeded blobs is what makes a staging `python3`
      // prove the hosted path rather than a copy of it.
      "r2_buckets": [
        { "binding": "BACKUP_BUCKET", "bucket_name": "kinu-backups-staging" },
        { "binding": "NIMBUS_RUNTIME_CACHE", "bucket_name": "nimbus-runtime-cache" },
        { "binding": "FEEDBACK_BUCKET", "bucket_name": "kinu-feedback-staging" }
      ],
      // Staging's own memory index, at the 384 dimensions the Workers AI
      // embedder produces. Production's index is NOT bound here: a shared one
      // would put every eval episode's vectors into the corpus real searches
      // read. Without a binding at all `runtime.ts` degrades to FTS5-only
      // (buildVectorStore returns the noop), so staging would answer 200 while
      // measuring a different retrieval path than production — the failure this
      // environment exists to catch, not to have.
      //
      // Both stores are EMPTY AND NEW rather than the pair that predates the
      // rename. Those held rows keyed to userIds the previous auth store
      // assigned, and this deployment assigns its own, so every one of them is
      // an orphan that would skew a staging retrieval measurement.
      "vectorize": [
        { "binding": "MEMORY_VECTORS", "index_name": "kinu-memory-staging" }
      ],
      "kv_namespaces": [
        { "binding": "AUTH_KV", "id": "c06cad3d9e2642258e80b4c4700e04be" }
      ],
      "vars": {
        "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f44999d1ddda7012e9a87729eba250f1/kinu-ai-gateway/workers-ai/v1",
        // Previews are off: they need a wildcard host per exposed port, and
        // nothing under this origin serves one yet. `exposePort` tells the agent
        // so rather than handing back a URL that cannot resolve; neither
        // executor is disabled by it.
        "PREVIEW_HOST_SUFFIX": "",
        "CLI_PUBLIC_ORIGIN": "https://staging.kinu.run",
        "CLI_APPROVAL_ORIGIN": "https://staging.kinu.run",
        // The eval service account: the one identity `DEV_IDENTITY_SECRET`
        // buys. Runs land on an account that holds nothing else, and
        // `eval-service` in a workspace list is self-explaining. Pinned as
        // EVAL_SERVICE_EMAIL in packages/test-utils/src/eval-identity.ts.
        "DEV_USER_EMAIL": "eval-service@kinu.run",
        // Same single choice as production — see the note on the production var.
        "SANDBOX_TRANSPORT": "rpc",
        // EMPTY, AND THIS IS THE LOAD-BEARING LINE IN THIS ENVIRONMENT.
        // `DEV_USER_EMAIL` above resolves a secret-bearing request to one
        // synthesized identity with a fresh auth time, so a non-empty allowlist
        // here would hand full admin authority to whoever holds that secret.
        // The admin gate independently refuses a `provider: 'dev'` identity, so
        // this is the second of two locks rather than the only one — but it is
        // the one a reader of this file can check.
        "CONTROL_PLANE_ADMINS": "",
        "CLOUDFLARE_ACCOUNT_ID": "f44999d1ddda7012e9a87729eba250f1",
        // Staging binds its own `*_staging` datasets and shares production's
        // account, so without this its metrics view would query — and present as
        // its own — production's rows.
        "ANALYTICS_DATASET_SUFFIX": "_staging"
      }
    }
  }
  // ── OPTIONAL: Vectorize binding for semantic memory ─────────────
  //
  // First create the index:
  //   wrangler vectorize create kinu-memory \
  //     --dimensions=384 --metric=cosine
  //
  // Then add the binding:
  //   ,"vectorize": [
  //     { "binding": "MEMORY_VECTORS", "index_name": "kinu-memory" }
  //   ]
  //
  // Once present, runtime.ts auto-detects it and constructs
  // CloudflareVectorStore; search_memory + searchMemoryHybrid return
  // RRF-merged FTS5 + Vectorize hits. Without it, agent transparently
  // falls back to FTS5-only.
}
