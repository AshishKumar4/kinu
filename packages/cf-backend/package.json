{
  "name": "@kinu.run/cf-backend",
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "vite dev --host 0.0.0.0",
    "//deploy": "This package publishes nothing. Both environments deploy from the repository root — `bun run deploy` and `bun run deploy:staging` run scripts/deploy.sh — which is the only path carrying the required gates, the CLI download asset check and the post-deploy smoke gate. Publishing from here once shipped production with none of the three CLI download assets, and every fresh install died on a checksum mismatch while the site looked fine.",
    "smoke:workspace": "bun scripts/smoke-workspace.ts",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
