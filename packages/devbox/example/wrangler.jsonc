// A Worker that uses Devbox with no Kinu code (DBX-9). `scripts/bench-devbox-standalone.ts`
// deploys it under a run's own name and bucket and deletes both afterwards; nothing else deploys it.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "kinu-devbox-example",
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "class_name": "ExampleBox", "name": "Box" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExampleBox"] }],
  // The image Devbox's storage needs: squashfuse, the block lower and the container's sync
  // (`packages/devbox/block-lower`), pinned by digest like the product's. Under the durable_object
  // scheduling policy the box starts the image named `devbox` at the size it chose (D50).
  // No local container: `wrangler dev` would need the Docker CLI for one. The example runs
  // deployed, through scripts/bench-devbox-standalone.ts.
  "dev": { "enable_containers": false },
  "containers": [
    {
      "class_name": "ExampleBox",
      "scheduling_policy": "durable_object"
    }
  ],
  "r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "kinu-devbox-example" }]
}
