// BENCHMARK FIXTURE CONFIG. Not part of any product deploy: no deploy script
// names this file, and it exists so a driver can raise a real container with a
// real R2 mount, run the shipped durability strategy against one workload, and
// then delete the Worker and the bucket.
//
// Everything that could change a measurement is pinned to the product's own
// value, with the reason beside it.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "kinu-devbox-bench",

  // The same account as the product's own config. This credential can see more
  // than one account and wrangler refuses to choose in non-interactive mode, so
  // naming it here is what makes the fixture runnable from a script instead of
  // from a prompt — which is also true of `wrangler dev`, because it builds the
  // container image.
  "account_id": "f44999d1ddda7012e9a87729eba250f1",
  "main": "worker.ts",

  "compatibility_date": "2026-09-30",
  // `nodejs_compat` for the same reason the product sets it. A different runtime
  // is a different measurement.
  "compatibility_flags": ["nodejs_compat"],

  // One reachable origin and nothing else: no custom domain, no route.
  // `wrangler dev --remote` is not an option — wrangler refuses it for Durable
  // Objects, so a container and a SQLite object are local-only there — and a
  // purely local run has neither a real container nor real R2 latency. A real
  // deployment is the only route to a number.
  "workers_dev": true,

  // On, because a mount refusal surfaces through logs, and a run that cannot
  // explain a failed arm has already spent the container time.
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      // ONE class, and the strategy is the class rather than a runtime switch:
      // a box's storage layout cannot change once it holds bytes, so the class
      // is what the migration and the container binding name.
      { "class_name": "SnapshotChainBox", "name": "SnapshotChainBox" },
      // The S3 gateway and this Worker need not share an isolate.
      { "class_name": "BenchOpCounter", "name": "BenchOpCounter" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SnapshotChainBox", "BenchOpCounter"]
    }
  ],

  // The durable_object scheduling policy: the box chooses its image and instance size at each
  // start (D50). Devbox starts the image named `devbox`.
  "containers": [
    {
      "class_name": "SnapshotChainBox",
      "scheduling_policy": "durable_object",
      "images": { "devbox": { "image": "registry.cloudflare.com/f44999d1ddda7012e9a87729eba250f1/kinu-devbox-native@sha256:7e0f8359ee78d1a486c02224cfa07a9d32d7533bfbd1070fc74411242a40d265" } }
    }
  ],

  // The driver creates this bucket before a run and deletes it after, and
  // refuses to run against a non-empty pre-existing one. Bound as
  // BACKUP_BUCKET because that is the binding NAME both strategies hand to
  // `mountBucket`, and the egress handler resolves the bucket out of the Worker
  // env by that name.
  //
  // A dedicated bucket, not a real backup bucket: benchmark traffic does not
  // belong in a keyspace holding real archives, and an ephemeral bucket makes
  // "leaves no resources" a property of teardown rather than of prefix
  // arithmetic.
  //
  // GIVE IT THE LIFECYCLE RULE THAT ABORTS INCOMPLETE MULTIPART UPLOADS WHEN YOU
  // CREATE IT, not after the first failure. A purge cannot promise an empty
  // bucket: pending multipart uploads count towards emptiness and the Workers
  // binding cannot enumerate them, so a bucket can report zero listable objects
  // and still refuse deletion. Once that happens the only remedy is the rule
  // plus waiting. Kept separate from any other run's bucket so two runs cannot
  // block each other's teardown.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "kinu-devbox-bench" }
  ]

  // BENCH_TOKEN is supplied per run through `wrangler deploy --var`, never
  // committed and never written to disk. An absent token makes every request
  // 401, so a fixture that outlives its run is inert rather than an open exec
  // endpoint on the public edge.
}
