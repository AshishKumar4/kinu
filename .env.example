# Proteus environment configuration
# Copy to .env and fill in your values:  cp .env.example .env
# NEVER commit .env with real tokens.

# ── CLI configuration ─────────────────────────────────────────────
# Used by `proteus chat`, `proteus evolve`, and E2E tests.

PROTEUS_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-name>/workers-ai/v1
PROTEUS_AUTH=Bearer <your-ai-gateway-token>
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── E2E test configuration ────────────────────────────────────────
# Same as above — used by packages/core/tests/e2e/ and tests/*.test.ts

AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-name>/workers-ai/v1
AI_GATEWAY_AUTH=Bearer <your-ai-gateway-token>
AI_GATEWAY_MODEL=@cf/moonshotai/kimi-k2.5

# ── Optional ──────────────────────────────────────────────────────

# PROTEUS_MODEL=@cf/moonshotai/kimi-k2.5
# PROTEUS_MAX_STEPS=500
