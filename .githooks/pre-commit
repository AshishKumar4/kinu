#!/usr/bin/env bash
#
# A lane's commit runs the ladder's `local` tier: the typecheck, the anti-slop lint and the structural gates
# over the whole tree, a few minutes, with no test rows and its results cached by content. An integration merge (branch integration/*) runs the full `commit` tier,
# test suites included: that is where every lane's work meets, and the place the owner asked the full checks
# to run (2026-10-06). The push tier and CI contain both.
#
# NEVER --no-verify. It checks the WORKING TREE, not the staged content; stashing to fix that loses work.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
source scripts/repo-runtime.sh
case "$(git symbolic-ref --short -q HEAD)" in
  integration/*) exec "$PWD/node_modules/.bin/bun" scripts/ladder.ts --tier=commit --changed=HEAD ;;
  *) exec "$PWD/node_modules/.bin/bun" scripts/ladder.ts --tier=local ;;
esac
