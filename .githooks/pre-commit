#!/usr/bin/env bash
#
# Every commit, batch merges included, runs the static `local` tier: the typecheck, the anti-slop lint and the
# structural gates over the whole tree, cached by content. The test suites run where the work meets: on GitHub
# CI's parallel runners for each pushed integration commit; a release ships only a commit whose CI is green.
#
# NEVER --no-verify. It checks the WORKING TREE, not the staged content; stashing to fix that loses work.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
source scripts/repo-runtime.sh
exec "$PWD/node_modules/.bin/bun" scripts/ladder.ts --tier=local
